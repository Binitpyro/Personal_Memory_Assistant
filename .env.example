# PMA Configuration Example
# Copy this file to .env and fill in your values

# ── Server Settings ───────────────────────────────────────────────────
PMA_HOST=127.0.0.1
PMA_PORT=8000
PMA_LOG_LEVEL=INFO

# ── Database & Storage ────────────────────────────────────────────────
# Mode: "portable" (relative to EXE) or "split_brain" (in User AppData)
PMA_LANCEDB_MODE=portable
# PMA_DB_PATH=data/pma_metadata.db
# PMA_LANCEDB_PERSIST_DIR=data/lancedb
# Keep a float16 SQLite vector backup in portable mode. Split-brain always keeps one
# and can backfill it after switching modes.
PMA_SQLITE_EMBEDDING_BACKUP=false

# Get your Gemini key from: https://aistudio.google.com/
PMA_GEMINI_API_KEY=your_gemini_api_key_here
PMA_GEMINI_MODEL=gemini-2.5-flash-lite

# Optional provider overrides
PMA_OPENAI_API_KEY=
PMA_OPENAI_BASE_URL=
PMA_ANTHROPIC_API_KEY=
PMA_GROQ_API_KEY=
PMA_OPENROUTER_API_KEY=
PMA_OPENAI_COMPATIBLE_API_KEY=
PMA_OPENAI_COMPATIBLE_BASE_URL=

# Ollama settings (for local LLMs)
PMA_OLLAMA_URL=http://localhost:11434/api/generate
PMA_OLLAMA_MODEL=llama3

# LM Studio settings
PMA_LM_STUDIO_URL=http://localhost:1234/v1

# ── Indexing Settings ─────────────────────────────────────────────────
PMA_INDEX_CONCURRENCY=16
PMA_CHUNK_SIZE=512
PMA_CHUNK_OVERLAP=50
PMA_MAX_FILE_SIZE_MB=50
