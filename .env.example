# ──────────────────────────────────────────────────────────────
# Personal Memory Assistant – Environment Configuration
# ──────────────────────────────────────────────────────────────
# Copy this file to .env and fill in your values.
# All variables use the PMA_ prefix (set by pydantic-settings).

# ── Server ────────────────────────────────────────────────────────────────
# PMA_HOST=127.0.0.1         # Always bind to localhost only — never 0.0.0.0
# PMA_PORT=8000               # HTTP port; desktop launcher may override with random port

# ── LLM — Gemini ──────────────────────────────────────────────────────────
# Get a free API key at https://aistudio.google.com/
PMA_GEMINI_API_KEY=
# PMA_GEMINI_MODEL=gemini-2.5-flash-lite   # Options: gemini-2.5-flash, gemini-2.5-pro
# PMA_GEMINI_MAX_OUTPUT_TOKENS=4096        # Max tokens per LLM response (was 1024)
# PMA_GEMINI_TIMEOUT=90.0                  # Request timeout in seconds

# ── LLM — Ollama (Local AI, auto-detected) ────────────────────────────────
# PMA_OLLAMA_URL=http://localhost:11434/api/generate
# PMA_OLLAMA_MODEL=llama3
# PMA_OLLAMA_TIMEOUT=60.0

# ── Embeddings ────────────────────────────────────────────────────────────
# PMA_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5   # 8-12% better MTEB than MiniLM, same size
# PMA_EMBEDDING_BATCH_SIZE=512                  # Auto-tuned at runtime (512/64/32 for CUDA/ONNX/CPU)

# ── Database ──────────────────────────────────────────────────────────────
# PMA_DB_PATH=data/pma_metadata.db
# PMA_SCHEMA_PATH=app/storage/schema.sql
# PMA_CHROMA_PERSIST_DIR=data/chroma_db

# ── File Indexing ─────────────────────────────────────────────────────────
# PMA_CHUNK_SIZE=512           # Characters per chunk (not tokens)
# PMA_CHUNK_OVERLAP=50         # Character overlap between consecutive chunks
# PMA_MAX_FILE_SIZE_MB=50      # Max single file size to extract and index
# PMA_INDEX_CONCURRENCY=16     # Parallel extraction workers
# PMA_SUPPORTED_EXTENSIONS=.txt,.md,.pdf,.docx,.csv,.json,.py,.js,.ts,.java,.c,.cpp,.rs,.go,.rb,.html,.css,.xml,.yaml,.yml,.toml,.ini,.cfg,.sh,.bat,.uasset,.umap,.uproject,.uplugin

# ── Retrieval / RAG ───────────────────────────────────────────────────────
# PMA_RETRIEVAL_TOP_K=15          # Chunks retrieved before reranking
# PMA_CONTEXT_MAX_TOKENS=8000     # Hard token budget fed to the LLM
# PMA_RRF_FTS_WEIGHT=0.4          # FTS5 Reciprocal Rank Fusion weight
# PMA_RRF_SEMANTIC_WEIGHT=0.6     # Semantic vector RRF weight
# PMA_RRF_K=60                    # RRF constant (lower = sharper ranking)
# PMA_RRF_SCORE_SCALE=1000        # Score multiplier for display
# PMA_SUMMARY_BOOST_FACTOR=1.25   # Boost score for folder-profile matches

# ── Dev / Feature Flags ───────────────────────────────────────────────────
# PMA_DEV_MODE=false       # true enables verbose logs & /debug/* endpoints
# PMA_LOG_LEVEL=INFO        # DEBUG / INFO / WARNING / ERROR

# ── Desktop Security (auto-set by launcher) ───────────────────────────────
# PMA_LOCAL_TOKEN=          # One-time cryptographic token; set automatically — do NOT set manually
