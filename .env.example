# PMA Configuration Example
# Copy this file to .env and fill in your values

# ── Server Settings ───────────────────────────────────────────────────
PMA_HOST=127.0.0.1
PMA_PORT=8000
PMA_LOG_LEVEL=INFO

# ── Local AI Providers (Default & Preferred) ───────────────────────────
# Ollama settings (for local LLMs)
PMA_OLLAMA_URL=http://localhost:11434
PMA_OLLAMA_MODEL=llama3

# LM Studio settings
PMA_LM_STUDIO_URL=http://localhost:1234/v1

# Local ONNX Embedding Model Settings
PMA_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
PMA_EMBEDDING_ALLOW_DOWNLOAD=true
PMA_EMBEDDING_ALLOW_UNPINNED=false

# ── Optional Cloud Provider Overrides ─────────────────────────────────
# Note: Cloud providers are used ONLY if configured and selected in fallback settings.
# Gemini API Key (Note: Free-tier Gemini keys may process data for model improvement)
PMA_GEMINI_API_KEY=
PMA_GEMINI_MODEL=gemini-2.5-flash-lite

# Other Cloud Providers
PMA_OPENAI_API_KEY=
PMA_OPENAI_BASE_URL=
PMA_ANTHROPIC_API_KEY=
PMA_GROQ_API_KEY=
PMA_NVIDIA_NIM_API_KEY=
PMA_NVIDIA_NIM_BASE_URL=
PMA_OPENROUTER_API_KEY=
PMA_OPENAI_COMPATIBLE_API_KEY=
PMA_OPENAI_COMPATIBLE_BASE_URL=

# ── Database & Storage ────────────────────────────────────────────────
# Mode: "portable" (relative to EXE) or "split_brain" (in User AppData)
PMA_LANCEDB_MODE=portable
# PMA_DB_PATH=data/pma_metadata.db
# PMA_LANCEDB_PERSIST_DIR=data/lancedb
PMA_SQLITE_EMBEDDING_BACKUP=false

# ── Indexing Settings ─────────────────────────────────────────────────
PMA_INDEX_CONCURRENCY=16
PMA_CHUNK_SIZE=512
PMA_CHUNK_OVERLAP=50
PMA_MAX_FILE_SIZE_MB=50

# ── OCR (Tier 1, CPU) ─────────────────────────────────────────────────
# Reads text out of scanned PDFs. The engine installs into its own venv
# (Settings -> OCR), so leaving this off costs nothing. Tier stays "none"
# until that install succeeds; enabling OCR without it is a no-op.
PMA_OCR_ENABLED=false
PMA_OCR_TIER=none
PMA_OCR_DPI=300
PMA_OCR_CACHE_MAX_MB=500

# ── Retrieval fusion ──────────────────────────────────────────────────
# Three ranked lists feed RRF: keyword (FTS5), semantic (vectors), and
# document summaries. The summary list is the routing signal - it decides
# which files are worth spending chunk budget on before the chunk-level
# signals argue over which passage answers. Set to 0 to disable it and fall
# back to 2-signal retrieval.
PMA_RRF_SUMMARY_WEIGHT=0.3
# Chunks pulled per summary-ranked file. Higher lets one long document push
# further into the candidate list; lower keeps the routing signal broad.
PMA_SUMMARY_EXPAND_CHUNKS_PER_FILE=5

# Allocate the result window across folder tags instead of taking a single
# global ranking. Off means whichever corpus ranks highest can take every
# slot, which on a mixed corpus hides your other domains behind a
# confident-looking answer.
PMA_FUSION_BALANCE_ENABLED=true
# Maximum share of the window any one domain may take (0.6 = 60%).
# Unfilled slots are backfilled by global rank, so this never costs recall.
PMA_FUSION_DOMAIN_CEILING=0.6

# ── Agentic retrieval (opt-in) ────────────────────────────────────────
# Decomposes a complex question into sub-questions, retrieves for each, and
# reports what it searched for and could not find. Off by default because it
# puts an extra LLM round-trip on the critical path - real latency on a local
# provider. Only full-RAG queries enter the loop; metadata fast paths never do.
PMA_AGENTIC_ENABLED=false
PMA_AGENTIC_MAX_ITERATIONS=2
# Cap on sub-questions. The per-sub-question chunk budget is this divided into
# the context ceiling, so raising it makes each branch shallower, not the
# answer bigger.
PMA_AGENTIC_SUBQUERY_MAX=4
# Score a chunk must beat to count as evidence for its sub-question. Raise it
# to make the loop more willing to call a sub-question unanswered.
PMA_AGENTIC_EVIDENCE_SCORE_FLOOR=0.0

# ── Folder watcher (opt-in) ───────────────────────────────────────────
# Re-indexes folders you have already indexed, on a timer, so the corpus does
# not drift from disk between manual runs. It only ever touches folders you
# indexed yourself, and skips a cycle while a manual index is running.
# Polls rather than subscribing to OS filesystem events - detection latency is
# the interval below, in exchange for no extra dependency and none of the
# editor write-burst or watch-limit problems event watchers bring.
PMA_WATCHER_ENABLED=false
# Seconds between checks. Floored at 10 regardless of what is set here.
PMA_WATCHER_INTERVAL_SECONDS=300
