# Auto detect text files and perform LF normalization
* text=auto

# Force LF for Rust files to prevent Sonar scanner parsing errors on Windows
*.rs text eol=lf

# The labelled eval corpus is addressed by character offset. The indexer
# reads in text mode, so a CRLF checkout would decode to LF and shift every
# answer_span past the first line - with nothing raising. Pin it.
tests/eval/corpus_large/** text eol=lf
tests/eval/queries_large.json text eol=lf

# Bundled tiktoken BPE file (A9-04): loaded only if its sha256 matches, so any
# EOL conversion on checkout would silently disable it. Keep the bytes exact.
app/assets/tiktoken/* -text

# cmd.exe mis-parses labels and goto in LF-only batch files.
*.bat text eol=crlf
*.cmd text eol=crlf
