# Personal Memory Assistant — Environment Configuration
# Copy this file to .env and fill in your values.
# Lines starting with # are comments and are ignored.

# ── LLM Provider (pick one) ────────────────────────────────────────────
# Gemini (recommended for cloud): get key at https://aistudio.google.com
GEMINI_API_KEY=

# Gemini model to use (default: gemini-2.5-flash-lite)
# GEMINI_MODEL=gemini-2.5-flash-lite

# Ollama (local): run `ollama serve` separately
# OLLAMA_URL=http://localhost:11434/api/generate
# OLLAMA_MODEL=llama3

# LM Studio (local): run LM Studio server separately
# LM_STUDIO_URL=http://localhost:1234/v1

# ── Server ─────────────────────────────────────────────────────────────
# HOST=127.0.0.1
# PORT=8000

# ── Storage paths (relative to working directory) ──────────────────────
# DB_PATH=data/pma_metadata.db
# LANCEDB_PERSIST_DIR=data/lancedb

# ── Indexing ───────────────────────────────────────────────────────────
# EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
# CHUNK_SIZE=512
# CHUNK_OVERLAP=50
# MAX_FILE_SIZE_MB=50
# INDEX_CONCURRENCY=16

# ── Debug ──────────────────────────────────────────────────────────────
# DEV_MODE=false
# LOG_LEVEL=INFO
